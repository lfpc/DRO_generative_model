__pycache__/
.claude/
*.pyc
outputs/
.ipynb_checkpoints/

# generated by the DRO experiments: figures, result data, checkpoints, run logs.
# Everything here is reproducible by re-running the scripts, and the figures are large
# binaries that churn on every run.
DRO/experiments/**/figs/
DRO/experiments/**/results/
DRO/experiments/**/logs/
*.json
*.pt
*.h5
*_log.txt
log_*.txt
tune_*.txt

# Downloaded datasets. MNIST's raw IDX files are 53 MB and problem.py re-fetches them on
# first use, so the repository carries the code that gets them rather than the bytes.
DRO/experiments/mnist/data/

# LaTeX build products
*.aux
*.log
*.out
*.bbl
*.blg
*.synctex.gz
# build output at the top level only -- DRO/latex/figs/*.pdf are the paper's figures
# and, now that the study data is gone, the only surviving copy of them
DRO/latex/*.pdf

# Robustness analysis: results, figures and the report's build are generated by the scripts
# (run_all.sh, report/figs.sh), so only the code and the .tex are tracked; the first analysis'
# reports are kept as PDFs (old_report/: their code and data are gone from the tree).
*.npz
*.png
*.pdf
!DRO/latex/figs/*.pdf
!old_report/**/*.pdf
report/figs/
old_report/**/figs/
*.fdb_latexmk
*.fls
*.toc
